rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cover-Uploads: nur Admin (UID siehe firestore.rules), max 5MB, nur Bilder
    match /covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'nRMiuZsj4GZQ0siYXFOqXVCc7mB2'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Avatare: Owner oder Admin, max 2MB, nur Bilder
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == userId || request.auth.uid == 'nRMiuZsj4GZQ0siYXFOqXVCc7mB2')
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
