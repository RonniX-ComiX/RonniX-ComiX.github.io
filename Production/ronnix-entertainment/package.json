{
  "name": "ronnix-comix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:ssg": "tsc --noEmit && vite build && vite-ssg-react build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "preview": "vite preview --port 4174 --strictPort",
    "env:check": "node scripts/check-env.mjs",
    "covers:check": "node scripts/check-covers.mjs --dry-run",
    "sitemap:check": "node scripts/check-sitemap.mjs --dry-run"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.15",
    "firebase": "^12.9.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.3",
    "vite-ssg-react": "^0.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.11.24",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1"
  }
}
