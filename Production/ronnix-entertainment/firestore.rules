rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'nRMiuZsj4GZQ0siYXFOqXVCc7mB2';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isAuth() {
      return request.auth != null;
    }

    // --- MATCH RULES ---

    // Regeln für Blog-Posts
    match /posts/{postId} {
      allow read: if true;
      // Admins darf alles
      allow write: if isAdmin();
      
      // Authentifizierte User dürfen Transaction-Updates für Votes machen (Counters)
      allow update: if isAuth() 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'dislikesCount']);

      // SUB-COLLECTION: Votes (Post Votes)
      match /votes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // SUB-COLLECTION: Comments
      match /comments/{commentId} {
        allow read: if true;
        // Authentifizierte User dürfen erstellen
        allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
        
        // Update Regeln:
        // 1. Owner darf Text ändern
        // 2. Jeder Auth-User darf Counters (Likes) ändern
        allow update: if isAuth() && (
          (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'dislikesCount'])
        );

        // Löschen: Owner oder Admin
        allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());

        // SUB-SUB-COLLECTION: Comment Votes
        match /votes/{userId} {
          allow read: if true;
          allow write: if isOwner(userId);
        }
      }
    }

    // Regeln für öffentliche User-Profile
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // SPEZIAL-REGEL FÜR ADMIN CHECK
    match /admin_utils/{document=**} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}