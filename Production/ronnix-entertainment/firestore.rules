rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'nRMiuZsj4GZQ0siYXFOqXVCc7mB2';
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function isAuth() {
      return request.auth != null;
    }
    function isValidPost() {
      return request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 160
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 50000
        && request.resource.data.category in ['news', 'comics', 'books', 'games', 'movies', 'series']
        && (!('coverUrl' in request.resource.data) || request.resource.data.coverUrl is string)
        && (!('themes' in request.resource.data) || request.resource.data.themes is list)
        && (!('author' in request.resource.data) || request.resource.data.author is string)
        && (!('artist' in request.resource.data) || request.resource.data.artist is string)
        && (!('inker' in request.resource.data) || request.resource.data.inker is string)
        && (!('colorist' in request.resource.data) || request.resource.data.colorist is string)
        && (!('letterer' in request.resource.data) || request.resource.data.letterer is string)
        && (!('editor' in request.resource.data) || request.resource.data.editor is string)
        && (!('executiveEditor' in request.resource.data) || request.resource.data.executiveEditor is string)
        && (!('coverArtists' in request.resource.data) || request.resource.data.coverArtists is list)
        && (!('releaseYearDe' in request.resource.data) || request.resource.data.releaseYearDe is string)
        && (!('releaseYearOriginal' in request.resource.data) || request.resource.data.releaseYearOriginal is string)
        && (!('originCountry' in request.resource.data) || request.resource.data.originCountry is string)
        && (!('publisherDe' in request.resource.data) || request.resource.data.publisherDe is string)
        && (!('publisherOriginal' in request.resource.data) || request.resource.data.publisherOriginal is string);
    }
    function isValidComment() {
      return request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000
        && request.resource.data.userId == request.auth.uid
        && (!('parentId' in request.resource.data) || request.resource.data.parentId is string || request.resource.data.parentId == null);
    }

    // --- POSTS ---
    match /posts/{postId} {
      allow read: if true;
      // Nur Admin schreibt Posts (inkl. Counter — Counter laufen über Functions/Admin-SDK)
      allow create: if isAdmin() && isValidPost();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Votes: Owner schreibt nur eigenes Vote-Doc mit validem value, Counter NICHT clientseitig
      match /votes/{userId} {
        allow read: if true;
        allow create, update: if isOwner(userId)
          && request.resource.data.value in [1, -1]
          && request.resource.data.keys().hasOnly(['value', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth() && isValidComment();
        // Owner darf nur Text ändern, Counter nur via Functions
        allow update: if isAuth()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 5000;
        allow delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());

        match /votes/{userId} {
          allow read: if true;
          allow create, update: if isOwner(userId)
            && request.resource.data.value in [1, -1]
            && request.resource.data.keys().hasOnly(['value', 'updatedAt']);
          allow delete: if isOwner(userId);
        }
      }
    }

    // --- USERS (public, ohne PII) ---
    // email gehört NICHT hierher -> usersPrivate/{uid}. Bestehende email-Felder migrieren/löschen.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 40
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string)
        && !('email' in request.resource.data)
        && !('lastLogoutAt' in request.resource.data);
      allow update: if (isOwner(userId) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'uid', 'lastUsernameUpdate', 'lastAvatarUpdate'])
        && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 40));
      allow delete: if false;
    }

    // --- USERS PRIVATE (PII: email, nur Owner/Admin) ---
    match /usersPrivate/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- COMMENT SUBSCRIPTIONS (In-App-Notify-Opt-in, nur eigenes Doc; kein E-Mail-Feld) ---
    match /commentSubscriptions/{subId} {
      allow read: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'notifyReplies', 'createdAt', 'updatedAt']);
      allow update: if isAuth()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyReplies', 'updatedAt']);
      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // --- NOTIFICATIONS (nur Functions schreiben, Owner liest/schließt) ---
    match /notifications/{userId}/items/{itemId} {
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // --- GLOBAL LOGOUT SIGNAL (nur Functions schreiben, Clients lesen eigenes Doc) ---
    match /logoutSignals/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /admin_utils/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
